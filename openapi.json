{
  "openapi": "3.1.0",
  "info": {
    "title": "Chesterfield Twin",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "post": {
        "summary": "Exchange",
        "operationId": "exchange_api_v1_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "secret": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 32,
                    "title": "Secret"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "secret"
                ],
                "title": "SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bootstrap": {
      "get": {
        "summary": "Get Bootstrap",
        "operationId": "get_bootstrap_api_v1_bootstrap_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bootstrap"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Bootstrap": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          },
          "active_release_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Release Id"
          },
          "has_baseline": {
            "type": "boolean",
            "title": "Has Baseline",
            "default": false
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Bootstrap"
      },
      "SessionResponse": {
        "properties": {
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "csrf_token"
        ],
        "title": "SessionResponse"
      }
    }
  }
}
